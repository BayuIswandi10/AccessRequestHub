@page "/my-requests"
@inject ApiClient Api
@inject NavigationManager Nav

<h2>My Requests</h2>

@if (_loading)
{
    <p>Loading...</p>
}
else if (!_requests.Any())
{
    <div class="alert alert-info">No requests found.</div>
}
else
{
    <div class="mb-3" style="max-width: 400px;">
        <input type="text" class="form-control" placeholder="Search by Application Name..." @bind="_searchText" @bind:event="oninput" />
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Application</th>
                <th>Environment</th>
                <th>Access Level</th>
                <th>Status</th>
                <th>Created</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in FilteredRequests)
            {
                <tr>
                    <td>@r.ApplicationName</td>
                    <td>@r.Environment</td>
                    <td>@r.AccessLevel</td>
                    <td><span class="badge @GetStatusBadge(r.Status)">@r.Status</span></td>
                    <td>@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><a href="request/@r.Id" class="btn btn-sm btn-outline-primary">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AccessRequestListDto> _requests = new();
    private bool _loading = true;
    private string _searchText = "";

    private IEnumerable<AccessRequestListDto> FilteredRequests =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _requests
            : _requests.Where(r => r.ApplicationName.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _requests = await Api.GetMyRequestsAsync();
        _loading = false;
    }

    private string GetStatusBadge(RequestStatus status) => status switch
    {
        RequestStatus.PendingManager => "bg-warning text-dark",
        RequestStatus.PendingSystemOwner => "bg-info text-dark",
        RequestStatus.Approved => "bg-success",
        RequestStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}
